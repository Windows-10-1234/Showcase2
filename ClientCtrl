function setMenuRig()
	local Rig = workspace:WaitForChild("Rig_Anim_Menu")
	local rigHum = Rig:WaitForChild("Humanoid")
	local idleAnim = Animations.MenuRig:WaitForChild("Idle")
	local actionAnim = Animations.MenuRig:WaitForChild("Action")
	local idleTrack = rigHum:LoadAnimation(idleAnim)
	local actionTrack = rigHum:LoadAnimation(actionAnim)
	idleTrack.Looped = true
	idleTrack:Play()
	task.spawn(function()
		while true do
			task.wait(20)
			if idleTrack.IsPlaying then idleTrack:Stop() end
			actionTrack:Play()
			actionTrack.Stopped:Wait()
			if not idleTrack.IsPlaying then idleTrack:Play() end
		end
	end)
end

function playMusic()
	local musicFolder = workspace.Sounds.Music
	local played = {}

	local function getTrack(i)
		return musicFolder:FindFirstChild(tostring(i))
	end

	local function getRandomIndex()
		if #played >= 5 then played = {} end
		local i
		repeat
			i = math.random(1, 5)
		until not table.find(played, i)
		table.insert(played, i)
		return i
	end

	local function playNext()
		local track = getTrack(getRandomIndex())
		if not track then return end
		track:Play()
		track.Ended:Wait()
		playNext()
	end

	task.spawn(playNext)
end

function setCameraMenu()
